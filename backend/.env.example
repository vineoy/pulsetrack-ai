# Copy this file to `.env` for running the API WITHOUT Docker (Docker Compose sets these for you).
# NEVER commit the real .env file - it holds secrets.

APP_NAME=PulseTrack AI
ENVIRONMENT=local

# Local (non-Docker) connections - inside Docker these hosts are `db` and `redis` instead of localhost.
# Host port is 5433 because a local PostgreSQL service owns 5432 on this machine.
DATABASE_URL=postgresql+asyncpg://pulse:pulse@localhost:5433/pulsetrack
REDIS_URL=redis://localhost:6379/0

# --- Secrets used from Phase 1 onwards ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# AI analyst (Phase 6). Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model is env-overridable; default is the cheapest free-tier text model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Telegram-only alerts (Phase 4). Get token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ESCALATION_DELAY_MIN=10
TELEGRAM_LINK_EXPIRE_MIN=15
